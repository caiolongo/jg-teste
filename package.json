{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1154.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@types/bun": "^1.4.3",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "migrate:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "migrate:pending": "bun run src/infrastructure/persistence/migrate.ts pending",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:compose": "bun run scripts/compose-check.ts",
    "test:load": "bun run scripts/load-test.ts",
    "localweb": "docker compose --profile localweb up -d --build --scale app=3 --wait && echo \"demo: http://localhost:8080\""
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
